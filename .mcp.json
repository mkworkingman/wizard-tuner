{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.12.0", "--isolated", "--no-usage-statistics"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["-y", "shadcn@4.23.0", "mcp"]
    },
    "storybook": {
      "type": "http",
