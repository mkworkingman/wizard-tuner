{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-on-stop.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm verify)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint*)",
      "Bash(pnpm format:check)",
      "Bash(pnpm test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "mcp__shadcn",
      "mcp__storybook"
    ],
    "ask": ["Bash(git push*)", "Bash(pnpm add*)", "Bash(pnpm remove*)", "Bash(pnpm dlx*)"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./pnpm-lock.yaml)",
      "Edit(./.next/**)",
      "Edit(./next-env.d.ts)"
    ]
  }
}
